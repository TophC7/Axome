{
  "version": 1,
  "tasks": [
    {
      "id": "dev",
      "label": "Tauri Dev",
      "command": "bun app:dev",
      "singleton": true,
      "clearOnRerun": false,
      "icon": "play",
      "group": "serve"
    },
    {
      "id": "dev-remote",
      "label": "Tauri Dev + Daemon",
      "command": "fish .axome/scripts/dev-remote.fish",
      "singleton": true,
      "clearOnRerun": false,
      "icon": "play",
      "group": "serve"
    },
    {
      "id": "dev-web",
      "label": "Web + Daemon",
      "command": "fish .axome/scripts/dev-remote.fish --web-only",
      "singleton": true,
      "clearOnRerun": false,
      "icon": "globe",
      "group": "serve"
    },
    {
      "id": "check",
      "label": "Typecheck",
      "command": "bun run check",
      "icon": "check",
      "group": "build"
    }
  ]
}
