{
  "id": "dev.axome.claude-code",
  "label": "Claude Code",
  "version": "1.0.0",
  "api": 1,
  "contributes": {
    "harnesses": [
      {
        "id": "claude_code",
        "label": "Claude Code",
        "command": "claude",
        "install_hint": "Install with: npm install -g @anthropic-ai/claude-code",
        "brand": {
          "icon": "./icons/claudecode.svg",
          "wordmark": "./icons/claudecode-text.svg",
          "wordmark_aspect": 8.272727,
          "gradient": ["#f29d84", "#763724"]
        },
        "history": { "builtin": "claude" },
        "terminal": {
          "resume_args": ["--resume", "${session_id}"],
          "new_session_args": ["--session-id", "${session_id}"]
        }
      }
    ]
  }
}
